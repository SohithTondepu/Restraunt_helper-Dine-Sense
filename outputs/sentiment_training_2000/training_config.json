{
  "task": "aspect-conditioned clause-level 3-class sentiment classification",
  "input_format": "Aspect: {aspect} [SEP] {clause}",
  "classes": [
    "Negative",
    "Neutral",
    "Positive"
  ],
  "random_seed": 42,
  "split_ratio": {
    "train": 0.7,
    "val": 0.15,
    "test": 0.15
  },
  "eligible_dataset_size": 5072,
  "hardware_used": "16-Core CPU (Intel/AMD x86_64)",
  "models_trained": [
    "Logistic Regression",
    "Linear SVM",
    "Random Forest",
    "XGBoost",
    "DistilBERT"
  ],
  "hyperparameters": {
    "Logistic Regression": {
      "C": 0.2,
      "class_weight": "balanced",
      "solver": "lbfgs"
    },
    "Linear SVM": {
      "C": 0.2,
      "class_weight": "balanced"
    },
    "Random Forest": {
      "n_estimators": 200,
      "max_depth": 20,
      "class_weight": "balanced"
    },
    "XGBoost": {
      "learning_rate": 0.1,
      "max_depth": 6,
      "n_estimators": 150
    },
    "DistilBERT": {
      "learning_rate": 3e-05,
